# ~/.config/ghostty/config
# Full reference: `ghostty +show-config --default --docs`

font-family = JetBrainsMono Nerd Font
font-size = 11
font-feature = -calt
adjust-cell-height = 10%

# niri sets prefer-no-csd, so let the compositor draw the frame.
window-decoration = false
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
background-opacity = 0.96

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard
scrollback-limit = 100000

confirm-close-surface = false
shell-integration = detect
shell-integration-features = cursor,sudo,title

# Tokyo Night, matching the tmux status line and the niri focus ring.
background = #1a1b26
foreground = #c0caf5
selection-background = #283457
selection-foreground = #c0caf5
cursor-color = #c0caf5

palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window

# Machine-local overrides, if the file exists (the ? makes it optional).
config-file = ?local
